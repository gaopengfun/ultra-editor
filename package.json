{
  "name": "ultra-editor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI Native rich text editor built on Tiptap",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "build": "pnpm --filter @ultra-editor/core build && pnpm --filter @ultra-editor/vue build",
    "build:playground": "pnpm build && pnpm --filter playground build",
    "type-check": "pnpm -r --parallel type-check",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint . -D correctness --ignore-path .gitignore",
    "lint:fix": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "format": "prettier --write \"packages/*/src/**/*.{ts,vue,css}\" \"playground/src/**/*.{ts,vue,css}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,vue,css}\"",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "verify": "pnpm lint && pnpm type-check && pnpm test && pnpm build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@types/node": "^25.9.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.0.18",
    "jsdom": "^28.0.4",
    "oxlint": "~1.69.0",
    "prettier": "3.8.4",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.3.4"
  }
}
