{
  "name": "ultra-editor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI Native rich text editor built on Tiptap",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@11.12.0",
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "build": "pnpm --filter @ultra-editor/core build && pnpm --filter @ultra-editor/vue build",
    "build:playground": "pnpm build && pnpm --filter playground build",
    "type-check": "pnpm -r --parallel type-check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint . -D correctness --ignore-path .gitignore",
    "lint:fix": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "format": "prettier --write \"packages/*/src/**/*.{ts,vue,css}\" \"packages/core/styles/**/*.css\" \"playground/src/**/*.{ts,vue,css}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,vue,css}\" \"packages/core/styles/**/*.css\" \"playground/src/**/*.{ts,vue,css}\"",
    "verify": "pnpm lint && pnpm type-check && pnpm test:coverage && pnpm build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^25.9.5",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^28.1.0",
    "oxlint": "~1.69.0",
    "prettier": "3.8.4",
    "typescript": "~6.0.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  }
}
