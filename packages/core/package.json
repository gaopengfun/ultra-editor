{
  "name": "@ultra-editor/core",
  "version": "1.0.0",
  "type": "module",
  "description": "Framework-agnostic Tiptap extensions and AI engine for ultra-editor",
  "keywords": ["tiptap", "prosemirror", "editor", "wysiwyg", "ai", "rich-text"],
  "license": "MIT",
  "author": "gaopeng",
  "homepage": "https://github.com/penggao4/ultra-editor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/penggao4/ultra-editor.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/penggao4/ultra-editor/issues",
  "sideEffects": ["*.css"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./providers/openai": {
      "types": "./dist/providers/openai.d.ts",
      "import": "./dist/providers/openai.js",
      "require": "./dist/providers/openai.cjs"
    },
    "./providers/anthropic": {
      "types": "./dist/providers/anthropic.d.ts",
      "import": "./dist/providers/anthropic.js",
      "require": "./dist/providers/anthropic.cjs"
    },
    "./styles.css": "./styles/index.css",
    "./content.css": "./styles/content.css",
    "./package.json": "./package.json"
  },
  "files": ["dist", "styles", "CHANGELOG.md"],
  "scripts": {
    "build": "vite build && pnpm build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "type-check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tiptap/core": "^3.26.1",
    "@tiptap/extension-code-block-lowlight": "^3.26.1",
    "@tiptap/extension-color": "^3.26.1",
    "@tiptap/extension-image": "^3.26.1",
    "@tiptap/extension-placeholder": "^3.26.1",
    "@tiptap/extension-table": "^3.27.3",
    "@tiptap/extension-text-style": "^3.26.1",
    "@tiptap/pm": "^3.26.1",
    "@tiptap/starter-kit": "^3.26.1",
    "@tiptap/suggestion": "^3.26.1",
    "lowlight": "^3.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
